{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "espanolconnatali.vercel.app"
        }
      ],
      "destination": "https://www.espanolconnatali.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tutor-preview/",
      "destination": "/api/tutor-preview"
    }
  ],
  "functions": {
    "api/tutor-preview.js": {
      "includeFiles": "private-preview/**"
    },
    "api/tutor-session.js": {
      "includeFiles": "private-preview/access-hash.json"
    }
  }
}
